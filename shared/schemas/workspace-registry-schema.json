{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkspaceRegistry",
  "type": "object",
  "required": [
    "workspace_name",
    "version",
    "last_updated",
    "cases"
  ],
  "properties": {
    "workspace_name": { "type": "string" },
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "active_case_id": { "type": ["string", "null"] },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "title", "status", "path", "created_at", "last_updated_at"],
        "properties": {
          "case_id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "path": { "type": "string" },
          "created_at": { "type": "string" },
          "last_updated_at": { "type": "string" },
          "last_session_id": { "type": ["string", "null"] }
        }
      }
    }
  },
  "additionalProperties": true
}

