{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionState",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "case_id",
    "status",
    "started_at",
    "objectives"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "session_id": { "type": "string", "pattern": "^SESSION-[0-9]{8}-[0-9]{3}$" },
    "case_id": { "type": "string" },
    "status": { "type": "string", "enum": ["ACTIVE", "CLOSED", "INTERRUPTED", "RECOVERY_PENDING"] },
    "started_at": { "type": "string" },
    "updated_at": { "type": ["string", "null"] },
    "closed_at": { "type": ["string", "null"] },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "completed_tasks": { "type": "array", "items": { "type": "string" } },
    "in_progress_tasks": { "type": "array", "items": { "type": "string" } },
    "blocked_tasks": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "issues": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "last_checkpoint_id": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}

